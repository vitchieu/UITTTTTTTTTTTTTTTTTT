#include <iostream>
using namespace std;
int main() {
    int n;
    cin >> n;
    int a[100];
    for (int i =0; i < n ; i++){
        cin >> a[i];
    }
    int x,k;
    cin >> x>> k;
    for (int i = 0; i <= n; i++) {
        if (i == k) {
            cout << x << " ";
        }
        if (i < n) {
            cout << a[i] << " ";
        }
    }
    return 0;
}
