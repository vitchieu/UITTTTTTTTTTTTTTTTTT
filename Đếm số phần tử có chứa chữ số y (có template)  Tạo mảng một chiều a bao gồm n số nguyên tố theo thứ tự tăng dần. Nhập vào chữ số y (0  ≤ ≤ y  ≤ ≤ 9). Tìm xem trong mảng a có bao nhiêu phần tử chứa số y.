
#include <iostream>
#include <math.h>
using namespace std;
#define MAX 100

void NhapmangSNT(int a[], int &n);
int SoPhanTuChuaY(int a[], int n,int y);





int songt( int x){
    if (x< 2) return 0;
    else{
        for (int i =2 ; i * i <= x ; i++){
            if (x % i == 0){
               return 0; 
            }
        }
    }
    return 1;
}
void NhapmangSNT(int a[], int &n){
    cin >> n;
    int dem =0;
    int so =2;
    while (dem < n){
        if (songt(so) == 1){
            a[dem]= so;
            dem ++;
        }
        so++;
    }
}
int SoPhanTuChuaY(int a[], int n,int y){
    int tong =0;
    for (int i =0 ; i<n ; i++){
        int tim = 0;
        for (int f= a[i]; f >0; f /=10){
            if (f % 10 == y){
                tim =1;
                break;
            }
        }
        if (tim ==1){
            tong ++;
        }
    }
    return tong;
}






int main()
{
	int a[MAX], n, y;
	cin >>y;
	NhapmangSNT(a,n);
	cout << SoPhanTuChuaY(a, n, y) << endl;;
	return 0;
}
