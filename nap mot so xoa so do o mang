#include <iostream>
using namespace std;
int main() {
    int n;
    cin >> n;
    int a[100];
    for (int i =0; i < n ; i++){
        cin >> a[i];
    }
    int x;
    cin >> x;
    for ( int i =0 ; i < n ; i++){
        int thay =0;
        int f = a[i];
        for (f; f >0; f /=10){
            if (f % 10 == x){
                thay =1;
            }
        }
        if ( thay == 1 ){
            for (int j = i; j < n - 1; j++) {
                a[j] = a[j + 1];
            }
            n--;
            i--;
        }
    }
    for (int i =0; i <n; i++) cout << a[i] << " ";
    return 0;
}
