#include <iostream>
using namespace std;
bool snt( int n){
    if (n <2) return false;
    for (int i =2; i * i <=n; i++){
        if (n %i ==0){
            return false;
        }
    }
    return true;
}
int sobandau( int n){
    int sodadao= 0;
    for (n; n>0 ; n /=10){
        sodadao= sodadao *10 + n%10;
    }
    return sodadao;
}
int main(){
    int a,b; 
    cin >> a >>b ;
    int dem =0 ;
    for (int x = a; x <=b ; x++){
        if ( snt (x) && snt(sobandau(x))){
            dem++;
        }
    }
    cout << dem;
}
