#include <iostream>
using namespace std;
int main() {
    int c[100];
    int n;
    cin >> n;
    int a[100];
    for (int i=0;i < n; i++){
        cin >> a[i];
    }
    int m;
    cin >> m;
    int b[100];
    for (int j = 0; j < m; j++){
        cin >> b[j];
    }
    int i =0;
    int j=0;
    int k=0;
    while (i < n && j < m){
        if (a[i] <= b[j]){
            c[k]= a[i];
            i++;
        }
        else{
            c[k] = b[j];
            j++;
        }
        k++;
    }
    while (i < n){
        c[k] =a[i];
        k++;
        i++;
    }
    while (j < m){
        c[k] =b[j];
        k++;
        j++;
    }
    for (int i =0 ; i < k; i++){
        cout << c[i] << " ";
    }
    return 0;
}
