#include <iostream>
using namespace std;
int main(){
    long long n;
    cin >> n;
    long long dem =0;
    for (long long i =3 ; i+2 <n; i+=2){
        bool ngt= true;
        for (long long j=2; j*j <=i; j++){
            if (i%j==0){
                ngt = false;
                break;
            }    
        }
        bool ngt1= true;
        for (long long j=2 ; j*j <= (i+2); j++){
            if ((i+2)%j==0){
                ngt1 = false;
                break;
            }    
        }
        if (ngt && ngt1){
            cout <<i <<","<<" "<<i+2<<endl;
            dem++;
        }
    }
    cout << "Tong: "<<dem<< " "<<"cap so sinh doi < " <<n <<endl;
    return 0;
}
