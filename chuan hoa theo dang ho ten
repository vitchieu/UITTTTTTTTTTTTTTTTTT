#include <iostream>
#include <stdio.h>
using namespace std;
#define MAX 300
int main(){
    char s[MAX];
    fgets(s, MAX, stdin);
    int up =0;
    for(;s[up] != '\0'; up++);
    for(;up>0 && (s[up-1] == '\n' || s[up-1] == '\r'); up--){
        s[up -1] ='\0';
    }
    for(;s[0] ==' '; up--){
        for(int i =0; i < up; i++){
            s[i] = s[i+1];
        }
    }
    for(;up > 0 && s[up -1] == ' '; up--){
        s[up - 1] = '\0';
    }
    for(int i=0; i < up - 1; i++){
        if(s[i] == ' ' && s[i+1] == ' '){
            for(int j=i; j < up; j++){
                s[j] =s[j+1];
            }
            up--;
            i--;
        }
    }
    for (int i =0; i < up; i++){
        if (s[i] >= 'A' && s[i] <= 'Z'){
            s[i] = tolower(s[i]);
        }
    }
    if (up > 0 && s[0] >= 'a' && s[0] <= 'z'){
        s[0] = toupper(s[0]);
    }
    for (int i =1 ; i < up; i++ ){
        if (s[i-1] ==' ' && s[i] >= 'a' && s[i] <= 'z'){
            s[i]= toupper(s[i]);
        }
    }
    cout << s;
    return 0;
}
