#include <iostream>
void input(int &a) {
    std::cin >> a;
}
long long TongChuSo(int a){
    long long tong =0;
    if (a < 0) a = -a; 
    

    for (; a > 0; a /= 10){
        tong += a % 10;
    }
    return tong;
}







int main (){
    int a;
    input(a);
    std::cout <<TongChuSo(a);
    return 0;
}
