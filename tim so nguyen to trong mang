#include <iostream>
using namespace std;
int main(){
    int n;
    cin >> n;
    int a[100];
    bool co = false;
    for (int i = 0; i<n ; i++){
        cin >> a[i];
        bool ngt = (a[i] >=2);
        for (int j =2; j * j <=a[i]; j++){
            if (a[i]%j==0){
                ngt = false;
                break;
            }
        }
        if (ngt){
            cout << a[i] << " ";
            co =true;
        }
    }
    if (!co){
        cout << "0";
    }
    return 0;
}
