int Input() {
    int x;
    cin >> x;
    return x;
}
long long sum_even_divisor(int n) {
    if (n%2 !=0){
        return -1;
    }
    long long tong=0;
    for (long long i=1; i*i<=n; ++i){
        if (n%i==0){
            if (i%2==0){
                tong += i;
            }
            long long uoc2=n/i;
            if (uoc2!=i && uoc2 %2==0){
                tong +=uoc2;
            }
        }
    }
    if (tong == 0){
        return -1;
    }
    else{
        return tong;
    }
}
int main(){
    int n;
    n=Input();
    cout << sum_even_divisor( n);
    return 0;
}
